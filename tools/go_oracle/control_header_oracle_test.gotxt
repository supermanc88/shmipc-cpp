func TestV2HandshakeInterop(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("full shmipc Session initialization requires Linux")
	}
	helper := os.Getenv("SHMIPC_CPP_V2_HANDSHAKE_HELPER")
	if helper == "" {
		t.Fatal("SHMIPC_CPP_V2_HANDSHAKE_HELPER is not set")
	}

	t.Run("GoClientToCppServer", func(t *testing.T) {
		directory := t.TempDir()
		mappedSignal := filepath.Join(directory, "mapped")
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		defer listener.Close()
		port := listener.Addr().(*net.TCPAddr).Port
		command := exec.Command(helper, "server", "127.0.0.1", strconv.Itoa(port), mappedSignal)
		if err := command.Start(); err != nil {
			t.Fatal(err)
		}
		connection, err := listener.Accept()
		if err != nil {
			command.Process.Kill()
			t.Fatal(err)
		}
		config := DefaultConfig()
		config.LogOutput = io.Discard
		config.InitializeTimeout = 5 * time.Second
		config.QueueCap = 64
		config.ShareMemoryBufferCap = 1 << 20
		config.QueuePath = filepath.Join(directory, "go-queue")
		config.ShareMemoryPathPrefix = filepath.Join(directory, "go")
		config.BufferSliceSizes = []*SizePercentPair{{Size: 4096, Percent: 60}, {Size: 8192, Percent: 40}}
		session, sessionErr := newSession(config, connection, true)
		if sessionErr == nil && (session == nil || session.queueManager == nil || session.bufferManager == nil) {
			sessionErr = fmt.Errorf("Go client returned incomplete resources")
		}
		if sessionErr == nil && (session.queueManager.sendQueue.cap != 64 || session.bufferManager.minSliceSize != 4096 || session.bufferManager.maxSliceSize != 8192) {
			sessionErr = fmt.Errorf("Go client resources do not match C++ server expectations")
		}
		if sessionErr == nil {
			sessionErr = os.WriteFile(mappedSignal, []byte("mapped"), 0o600)
		}
		if sessionErr != nil {
			connection.Close()
			command.Process.Kill()
		}
		helperErr := command.Wait()
		if sessionErr != nil || helperErr != nil {
			t.Fatalf("Go client=%v C++ server=%v", sessionErr, helperErr)
		}
		if err := session.Close(); err != nil {
			t.Fatal(err)
		}
	})

	t.Run("CppClientToGoServer", func(t *testing.T) {
		directory := t.TempDir()
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		defer listener.Close()
		port := listener.Addr().(*net.TCPAddr).Port
		queuePath := filepath.Join(directory, "cpp-queue")
		bufferPath := filepath.Join(directory, "cpp-buffer")
		mappedSignal := filepath.Join(directory, "mapped")
		command := exec.Command(helper, "client", "127.0.0.1", strconv.Itoa(port), queuePath, bufferPath, mappedSignal)
		if err := command.Start(); err != nil {
			t.Fatal(err)
		}
		connection, err := listener.Accept()
		if err != nil {
			command.Process.Kill()
			t.Fatal(err)
		}
		config := DefaultConfig()
		config.LogOutput = io.Discard
		config.InitializeTimeout = 5 * time.Second
		session, sessionErr := newSession(config, connection, false)
		if sessionErr == nil && (session == nil || session.queueManager == nil || session.bufferManager == nil) {
			sessionErr = fmt.Errorf("Go server returned incomplete resources")
		}
		if sessionErr == nil {
			if session.queueManager.path != queuePath || session.bufferManager.path != bufferPath {
				sessionErr = fmt.Errorf("mapped paths do not match metadata")
			}
			if err := os.WriteFile(mappedSignal, []byte("mapped"), 0o600); err != nil {
				sessionErr = err
			}
		}
		if sessionErr != nil {
			connection.Close()
			command.Process.Kill()
		}
		helperErr := command.Wait()
		if sessionErr != nil || helperErr != nil {
			t.Fatalf("C++ client=%v Go server=%v", helperErr, sessionErr)
		}
		if err := session.Close(); err != nil {
			t.Fatal(err)
		}
	})
}

func TestV2ClientSessionInterop(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("full shmipc Session initialization requires Linux")
	}
	helper := os.Getenv("SHMIPC_CPP_V2_CLIENT_SESSION_HELPER")
	if helper == "" {
		t.Fatal("SHMIPC_CPP_V2_CLIENT_SESSION_HELPER is not set")
	}
	directory := t.TempDir()
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	defer listener.Close()
	port := listener.Addr().(*net.TCPAddr).Port
	queuePath := filepath.Join(directory, "cpp-session-queue")
	bufferPath := filepath.Join(directory, "cpp-session-buffer")
	command := exec.Command(helper, "client", "127.0.0.1", strconv.Itoa(port), queuePath, bufferPath)
	if err := command.Start(); err != nil {
		t.Fatal(err)
	}
	connection, err := listener.Accept()
	if err != nil {
		command.Process.Kill()
		t.Fatal(err)
	}
	config := DefaultConfig()
	config.LogOutput = io.Discard
	config.InitializeTimeout = 5 * time.Second
	session, sessionErr := newSession(config, connection, false)
	if sessionErr == nil {
		var stream *Stream
		stream, sessionErr = session.AcceptStream()
		if sessionErr == nil {
			request := make([]byte, 20000)
			_, sessionErr = io.ReadFull(stream, request)
			if sessionErr == nil {
				for _, value := range request {
					if value != 0x3c {
						sessionErr = fmt.Errorf("C++ request marker mismatch")
						break
					}
				}
			}
			if sessionErr == nil {
				_, sessionErr = stream.Write(bytes.Repeat([]byte{0x6b}, 17000))
			}
			if closeErr := stream.Close(); sessionErr == nil && closeErr != nil {
				sessionErr = closeErr
			}
		}
	}
	if sessionErr != nil {
		connection.Close()
		command.Process.Kill()
	}
	helperErr := command.Wait()
	if session != nil {
		if closeErr := session.Close(); sessionErr == nil && closeErr != nil {
			sessionErr = closeErr
		}
	}
	if sessionErr != nil || helperErr != nil {
		t.Fatalf("C++ client=%v Go server=%v", helperErr, sessionErr)
	}
}

func TestV2ServerSessionInterop(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("full shmipc Session initialization requires Linux")
	}
	helper := os.Getenv("SHMIPC_CPP_V2_SERVER_SESSION_HELPER")
	if helper == "" {
		t.Fatal("SHMIPC_CPP_V2_SERVER_SESSION_HELPER is not set")
	}

	run := func(t *testing.T, scenario string, interact func(*Stream, string) error) {
		t.Helper()
		directory := t.TempDir()
		signal := filepath.Join(directory, "close-observed")
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		defer listener.Close()
		port := listener.Addr().(*net.TCPAddr).Port
		command := exec.Command(helper, "server", "127.0.0.1", strconv.Itoa(port), scenario, signal)
		var helperOutput bytes.Buffer
		command.Stdout = &helperOutput
		command.Stderr = &helperOutput
		if err := command.Start(); err != nil {
			t.Fatal(err)
		}
		connection, err := listener.Accept()
		if err != nil {
			command.Process.Kill()
			t.Fatal(err)
		}
		config := DefaultConfig()
		config.LogOutput = io.Discard
		config.InitializeTimeout = 5 * time.Second
		config.QueueCap = 64
		config.ShareMemoryBufferCap = 1 << 20
		config.QueuePath = filepath.Join(directory, "go-server-queue")
		config.ShareMemoryPathPrefix = filepath.Join(directory, "go-server")
		config.BufferSliceSizes = []*SizePercentPair{{Size: 4096, Percent: 60}, {Size: 8192, Percent: 40}}
		session, sessionErr := newSession(config, connection, true)
		if sessionErr == nil {
			var stream *Stream
			stream, sessionErr = session.OpenStream()
			if sessionErr == nil && stream.StreamID() != 2 {
				sessionErr = fmt.Errorf("first Go stream ID = %d, want 2", stream.StreamID())
			}
			if sessionErr == nil {
				sessionErr = interact(stream, signal)
			}
		}
		if sessionErr != nil {
			connection.Close()
			command.Process.Kill()
		}
		helperErr := command.Wait()
		if session != nil {
			if closeErr := session.Close(); sessionErr == nil && closeErr != nil {
				sessionErr = closeErr
			}
		}
		if sessionErr != nil || helperErr != nil {
			t.Fatalf("Go client=%v C++ server=%v helper output=%s", sessionErr, helperErr, helperOutput.String())
		}
	}

	t.Run("MultiMessageAndCppClose", func(t *testing.T) {
		run(t, "roundtrip", func(stream *Stream, signal string) error {
			requests := [][]byte{
				bytes.Repeat([]byte{0x11}, 31),
				bytes.Repeat([]byte{0x22}, 20000),
				bytes.Repeat([]byte{0x33}, 7000),
			}
			for index, request := range requests {
				if _, err := stream.Write(request); err != nil {
					return fmt.Errorf("write request %d: %w", index, err)
				}
			}
			responses := [][]byte{
				bytes.Repeat([]byte{0x44}, 47),
				bytes.Repeat([]byte{0x55}, 17000),
				bytes.Repeat([]byte{0x66}, 9000),
			}
			for index, expected := range responses {
				actual := make([]byte, len(expected))
				if _, err := io.ReadFull(stream, actual); err != nil {
					return fmt.Errorf("read response %d: %w", index, err)
				}
				if !bytes.Equal(actual, expected) {
					return fmt.Errorf("C++ response mismatch")
				}
			}
			one := make([]byte, 1)
			if _, err := stream.Read(one); err == nil {
				return fmt.Errorf("expected C++ remote close")
			}
			return os.WriteFile(signal, []byte("observed"), 0o600)
		})
	})

	t.Run("GoClose", func(t *testing.T) {
		run(t, "remote-close", func(stream *Stream, _ string) error {
			if _, err := stream.Write(bytes.Repeat([]byte{0x11}, 31)); err != nil {
				return err
			}
			return stream.Close()
		})
	})
}

func TestV2MultiplexedSessionInterop(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("full shmipc Session initialization requires Linux")
	}
	helper := os.Getenv("SHMIPC_CPP_V2_MULTIPLEXED_SESSION_HELPER")
	if helper == "" {
		t.Fatal("SHMIPC_CPP_V2_MULTIPLEXED_SESSION_HELPER is not set")
	}
	request := func(id uint32) []byte {
		return bytes.Repeat([]byte{byte(0x20 + id)}, 2000+int(id)*3000)
	}
	response := func(id uint32) []byte {
		return bytes.Repeat([]byte{byte(0x40 + id)}, 3000+int(id)*2000)
	}

	t.Run("GoClientToCppServer", func(t *testing.T) {
		directory := t.TempDir()
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		defer listener.Close()
		port := listener.Addr().(*net.TCPAddr).Port
		command := exec.Command(helper, "server", "127.0.0.1", strconv.Itoa(port))
		var helperOutput bytes.Buffer
		command.Stdout = &helperOutput
		command.Stderr = &helperOutput
		if err := command.Start(); err != nil {
			t.Fatal(err)
		}
		connection, err := listener.Accept()
		if err != nil {
			command.Process.Kill()
			t.Fatal(err)
		}
		config := DefaultConfig()
		config.LogOutput = io.Discard
		config.InitializeTimeout = 5 * time.Second
		config.QueueCap = 64
		config.ShareMemoryBufferCap = 1 << 20
		config.QueuePath = filepath.Join(directory, "go-mux-queue")
		config.ShareMemoryPathPrefix = filepath.Join(directory, "go-mux")
		config.BufferSliceSizes = []*SizePercentPair{{Size: 4096, Percent: 60}, {Size: 8192, Percent: 40}}
		session, sessionErr := newSession(config, connection, true)
		var streams []*Stream
		if sessionErr == nil {
			for id := uint32(2); id <= 4; id++ {
				stream, err := session.OpenStream()
				if err != nil {
					sessionErr = err
					break
				}
				if stream.StreamID() != id {
					sessionErr = fmt.Errorf("Go stream ID = %d, want %d", stream.StreamID(), id)
					break
				}
				if _, err := stream.Write(request(id)); err != nil {
					sessionErr = err
					break
				}
				streams = append(streams, stream)
			}
		}
		if sessionErr == nil {
			for _, stream := range streams {
				actual := make([]byte, len(response(stream.StreamID())))
				if _, err := io.ReadFull(stream, actual); err != nil {
					sessionErr = err
					break
				}
				if !bytes.Equal(actual, response(stream.StreamID())) {
					sessionErr = fmt.Errorf("C++ response mismatch for stream %d", stream.StreamID())
					break
				}
				if err := stream.Close(); err != nil {
					sessionErr = err
					break
				}
			}
		}
		if sessionErr != nil {
			connection.Close()
			command.Process.Kill()
		}
		helperErr := command.Wait()
		if session != nil {
			session.Close()
		}
		if sessionErr != nil || helperErr != nil {
			t.Fatalf("Go client=%v C++ server=%v helper output=%s", sessionErr, helperErr, helperOutput.String())
		}
	})

	t.Run("CppClientToGoServer", func(t *testing.T) {
		directory := t.TempDir()
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		defer listener.Close()
		port := listener.Addr().(*net.TCPAddr).Port
		command := exec.Command(helper, "client", "127.0.0.1", strconv.Itoa(port), filepath.Join(directory, "cpp-mux-queue"), filepath.Join(directory, "cpp-mux-buffer"))
		var helperOutput bytes.Buffer
		command.Stdout = &helperOutput
		command.Stderr = &helperOutput
		if err := command.Start(); err != nil {
			t.Fatal(err)
		}
		connection, err := listener.Accept()
		if err != nil {
			command.Process.Kill()
			t.Fatal(err)
		}
		config := DefaultConfig()
		config.LogOutput = io.Discard
		config.InitializeTimeout = 5 * time.Second
		session, sessionErr := newSession(config, connection, false)
		if sessionErr == nil {
			for id := uint32(2); id <= 4; id++ {
				stream, err := session.AcceptStream()
				if err != nil {
					sessionErr = err
					break
				}
				if stream.StreamID() != id {
					sessionErr = fmt.Errorf("C++ stream ID = %d, want %d", stream.StreamID(), id)
					break
				}
				actual := make([]byte, len(request(id)))
				if _, err := io.ReadFull(stream, actual); err != nil {
					sessionErr = err
					break
				}
				if !bytes.Equal(actual, request(id)) {
					sessionErr = fmt.Errorf("C++ request mismatch for stream %d", id)
					break
				}
				if _, err := stream.Write(response(id)); err != nil {
					sessionErr = err
					break
				}
				if err := stream.Close(); err != nil {
					sessionErr = err
					break
				}
			}
		}
		if sessionErr != nil {
			connection.Close()
			command.Process.Kill()
		}
		helperErr := command.Wait()
		if session != nil {
			session.Close()
		}
		if sessionErr != nil || helperErr != nil {
			t.Fatalf("C++ client=%v Go server=%v helper output=%s", helperErr, sessionErr, helperOutput.String())
		}
	})
}

func TestBufferPoolInterop(t *testing.T) {
	helper := os.Getenv("SHMIPC_CPP_BUFFER_POOL_HELPER")
	if helper == "" {
		t.Fatal("SHMIPC_CPP_BUFFER_POOL_HELPER is not set")
	}
	path := filepath.Join(t.TempDir(), "buffer-pool")
	created, err := exec.Command(helper, "create", path).CombinedOutput()
	if err != nil {
		t.Fatalf("C++ create failed: %v: %s", err, created)
	}
	cppRootText := strings.TrimSpace(string(created))
	cppRoot, err := strconv.ParseUint(cppRootText, 10, 32)
	if err != nil {
		t.Fatalf("invalid C++ root %q: %v", cppRootText, err)
	}

	file, err := os.OpenFile(path, os.O_RDWR, 0)
	if err != nil {
		t.Fatal(err)
	}
	info, err := file.Stat()
	if err != nil {
		file.Close()
		t.Fatal(err)
	}
	memory, err := syscall.Mmap(int(file.Fd()), 0, int(info.Size()),
		syscall.PROT_READ|syscall.PROT_WRITE, syscall.MAP_SHARED)
	file.Close()
	if err != nil {
		t.Fatal(err)
	}
	bm, err := mappingBufferManager(path, memory, 0)
	if err != nil {
		syscall.Munmap(memory)
		t.Fatal(err)
	}

	const payloadSize = 20000
	const cppMarker = byte(0x3c)
	const goMarker = byte(0x6b)
	received := 0
	for offset := uint32(cppRoot); ; {
		slice, err := bm.readBufferSlice(offset)
		if err != nil {
			t.Fatal(err)
		}
		for _, value := range slice.data[slice.readIndex:slice.writeIndex] {
			if value != cppMarker {
				t.Fatalf("C++ payload marker mismatch at offset %d", offset)
			}
		}
		received += slice.size()
		hasNext := slice.hasNext()
		next := slice.nextBufferOffset()
		bm.recycleBuffer(slice)
		if !hasNext {
			break
		}
		offset = next
	}
	if received != payloadSize {
		t.Fatalf("C++ payload size: want %d, got %d", payloadSize, received)
	}

	outbound := newSliceList()
	if allocated := bm.allocShmBuffers(outbound, payloadSize); allocated < payloadSize {
		t.Fatalf("Go allocated only %d bytes", allocated)
	}
	goRoot := outbound.front().offsetInShm
	remaining := payloadSize
	for slice := outbound.front(); slice != nil && remaining > 0; slice = slice.next() {
		size := int(slice.cap)
		if size > remaining {
			size = remaining
		}
		for index := 0; index < size; index++ {
			slice.data[index] = goMarker
		}
		slice.readIndex = 0
		slice.writeIndex = size
		slice.start = 0
		slice.update()
		remaining -= size
	}
	if remaining != 0 {
		t.Fatalf("Go payload has %d unwritten bytes", remaining)
	}
	if err := syscall.Munmap(memory); err != nil {
		t.Fatal(err)
	}

	verified, err := exec.Command(helper, "verify", path,
		strconv.FormatUint(uint64(goRoot), 10)).CombinedOutput()
	if err != nil {
		t.Fatalf("C++ verify failed: %v: %s", err, verified)
	}
}

func TestQueueInterop(t *testing.T) {
	helper := os.Getenv("SHMIPC_CPP_QUEUE_HELPER")
	if helper == "" {
		t.Fatal("SHMIPC_CPP_QUEUE_HELPER is not set")
	}
	path := filepath.Join(t.TempDir(), "queue-manager")
	created, err := exec.Command(helper, "create", path).CombinedOutput()
	if err != nil {
		t.Fatalf("C++ queue create failed: %v: %s", err, created)
	}

	qm, err := mappingQueueManager(path)
	if err != nil {
		t.Fatal(err)
	}
	if !qm.recvQueue.consumerIsWorking() {
		t.Fatal("C++ did not publish working flag")
	}
	const elementCount = 1000
	for value := uint32(0); value < elementCount; value++ {
		element, err := qm.recvQueue.pop()
		if err != nil {
			t.Fatalf("Go queue pop %d: %v", value, err)
		}
		if element.seqID != value || element.offsetInShmBuf != value+7 ||
			element.status != value^0x55aa {
			t.Fatalf("C++ queue element mismatch at %d: %+v", value, element)
		}
	}
	if !qm.recvQueue.markNotWorking() || qm.recvQueue.consumerIsWorking() {
		t.Fatal("Go failed to retire C++ queue working flag")
	}
	for value := uint32(0); value < elementCount; value++ {
		if err := qm.sendQueue.put(queueElement{
			seqID: value + 10000, offsetInShmBuf: value + 17,
			status: value ^ 0xaa55,
		}); err != nil {
			t.Fatalf("Go queue put %d: %v", value, err)
		}
	}
	if !qm.sendQueue.markWorking() {
		t.Fatal("Go failed to publish working flag")
	}
	verified, err := exec.Command(helper, "verify", path).CombinedOutput()
	if err != nil {
		t.Fatalf("C++ queue verify failed: %v: %s", err, verified)
	}
}

func TestControlHeaderGolden(t *testing.T) {
	events := []struct {
		name      string
		typeValue eventType
	}{
		{"ShareMemoryByFilePath", typeShareMemoryByFilePath},
		{"Polling", typePolling},
		{"StreamClose", typeStreamClose},
		{"FallbackData", typeFallbackData},
		{"ExchangeProtoVersion", typeExchangeProtoVersion},
		{"ShareMemoryByMemfd", typeShareMemoryByMemfd},
		{"AckShareMemory", typeAckShareMemory},
		{"AckReadyRecvFD", typeAckReadyRecvFD},
		{"HotRestart", typeHotRestart},
		{"HotRestartAck", typeHotRestartAck},
	}

	goldenPath := os.Getenv("SHMIPC_CONTROL_HEADER_GOLDEN")
	if goldenPath == "" {
		t.Fatal("SHMIPC_CONTROL_HEADER_GOLDEN is not set")
	}
	golden, err := os.Open(goldenPath)
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	row := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 5 {
			t.Fatalf("invalid golden row %q", line)
		}
		if row >= len(events) || fields[0] != events[row].name {
			t.Fatalf("unexpected event at row %d: %q", row, fields[0])
		}

		length, err := strconv.ParseUint(fields[1], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		version, err := strconv.ParseUint(fields[2], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		typeValue, err := strconv.ParseUint(fields[3], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		if eventType(typeValue) != events[row].typeValue {
			t.Fatalf("unexpected type for %s: %d", fields[0], typeValue)
		}

		encoded := make(header, headerSize)
		encoded.encode(uint32(length), uint8(version), events[row].typeValue)
		actual := hex.EncodeToString(encoded)
		if actual != fields[4] {
			t.Fatal(fmt.Sprintf("header mismatch for %s: expected %s, got %s", fields[0], fields[4], actual))
		}
		row++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if row != len(events) {
		t.Fatalf("expected %d event rows, got %d", len(events), row)
	}
}

func TestSharedMemoryMetadataGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_SHM_METADATA_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	eventTypes := map[string]eventType{
		"ShareMemoryByFilePath": typeShareMemoryByFilePath,
		"ShareMemoryByMemfd":    typeShareMemoryByMemfd,
	}
	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 5 {
			t.Fatalf("invalid metadata golden row %q", line)
		}
		typeValue, ok := eventTypes[fields[0]]
		if !ok {
			t.Fatalf("unknown metadata event %q", fields[0])
		}
		version, err := strconv.ParseUint(fields[1], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		queuePath, err := hex.DecodeString(fields[2])
		if err != nil {
			t.Fatal(err)
		}
		bufferPath, err := hex.DecodeString(fields[3])
		if err != nil {
			t.Fatal(err)
		}
		session := Session{
			communicationVersion: uint8(version),
			queueManager:         &queueManager{path: string(queuePath)},
			bufferManager:        &bufferManager{path: string(bufferPath)},
		}
		actual := hex.EncodeToString(session.generateShmMetadata(typeValue))
		if actual != fields[4] {
			t.Fatalf("metadata mismatch for %s: expected %s, got %s", fields[0], fields[4], actual)
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 2 {
		t.Fatalf("expected 2 metadata rows, got %d", rows)
	}
}

func TestFallbackDataGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_FALLBACK_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 5 {
			t.Fatalf("invalid fallback golden row %q", line)
		}
		version, err := strconv.ParseUint(fields[0], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		streamID, err := strconv.ParseUint(fields[1], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		status, err := strconv.ParseUint(fields[2], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		payload, err := hex.DecodeString(fields[3])
		if err != nil {
			t.Fatal(err)
		}
		var event fallbackDataEvent
		event.encode(len(event)+len(payload), uint8(version), uint32(streamID), uint32(status))
		actual := hex.EncodeToString(append(event[:], payload...))
		if actual != fields[4] {
			t.Fatalf("fallback mismatch: expected %s, got %s", fields[4], actual)
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 1 {
		t.Fatalf("expected 1 fallback row, got %d", rows)
	}
}

func TestQueueLayoutGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_QUEUE_LAYOUT_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 9 {
			t.Fatalf("invalid queue layout golden row %q", line)
		}
		if fields[0] != runtime.GOARCH {
			continue
		}
		capacity, err := strconv.ParseUint(fields[1], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		values := make([]uint64, 6)
		for index := range values {
			values[index], err = strconv.ParseUint(fields[index+2], 16, 64)
			if err != nil {
				t.Fatal(err)
			}
		}
		memory := make([]byte, countQueueMemSize(uint32(capacity)))
		queue := createQueueFromBytes(memory, uint32(capacity))
		*queue.head = int64(values[0])
		*queue.tail = int64(values[1])
		*queue.workingFlag = uint32(values[2])
		*(*uint32)(unsafe.Pointer(&queue.queueBytesOnMemory[0])) = uint32(values[3])
		*(*uint32)(unsafe.Pointer(&queue.queueBytesOnMemory[4])) = uint32(values[4])
		*(*uint32)(unsafe.Pointer(&queue.queueBytesOnMemory[8])) = uint32(values[5])
		actual := hex.EncodeToString(memory)
		if actual != fields[8] {
			t.Fatalf("queue layout mismatch for %s: expected %s, got %s", fields[0], fields[8], actual)
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 1 {
		t.Fatalf("expected one queue layout row for %s, got %d", runtime.GOARCH, rows)
	}
}

func TestBufferLayoutGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_BUFFER_LAYOUT_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	bufferNum := uint32(3)
	capacityPerBuffer := uint32(4)
	memory := make([]byte, countBufferListMemSize(bufferNum, capacityPerBuffer))
	creator, err := createFreeBufferList(bufferNum, capacityPerBuffer, memory, 0)
	if err != nil {
		t.Fatal(err)
	}
	mapper, err := mappingFreeBufferList(memory, 0)
	if err != nil {
		t.Fatal(err)
	}
	base := uintptr(unsafe.Pointer(&memory[0]))
	offsets := map[string]map[string]uint64{
		"manager": {"list_count": 0, "used_length": bmCapOffset},
		"list": {
			"size": 0, "capacity": 4, "head": 8, "tail": 12,
			"capacity_per_buffer": 16,
			"creator_counter":     uint64(uintptr(unsafe.Pointer(creator.counter)) - base),
			"mapper_counter":      uint64(uintptr(unsafe.Pointer(mapper.counter)) - base),
			"region":              bufferListHeaderSize,
		},
		"slice": {
			"capacity": bufferCapOffset, "size": bufferSizeOffset,
			"data_start": bufferDataStartOffset, "next": nextBufferOffset,
			"flags": bufferFlagOffset,
		},
	}
	sizes := map[string]uint64{
		"manager": bufferManagerHeaderSize,
		"list":    bufferListHeaderSize,
		"slice":   bufferHeaderSize,
	}

	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) < 3 {
			t.Fatalf("invalid buffer layout row %q", line)
		}
		kind := fields[0]
		totalSize, err := strconv.ParseUint(fields[1], 10, 64)
		expectedSize, knownKind := sizes[kind]
		if err != nil || !knownKind || expectedSize != totalSize {
			t.Fatalf("unexpected %s layout size %s", kind, fields[1])
		}
		for _, field := range fields[2:] {
			parts := strings.Split(field, "=")
			if len(parts) != 2 {
				t.Fatalf("invalid buffer layout field %q", field)
			}
			offset, err := strconv.ParseUint(parts[1], 10, 64)
			expectedOffset, knownField := offsets[kind][parts[0]]
			if err != nil || !knownField || expectedOffset != offset {
				t.Fatalf("unexpected %s.%s offset %s", kind, parts[0], parts[1])
			}
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 3 {
		t.Fatalf("expected 3 buffer layout rows, got %d", rows)
	}

	creatorBuffer, err := creator.pop()
	if err != nil {
		t.Fatal(err)
	}
	if *creator.counter != 1 || *mapper.counter != 0 {
		t.Fatalf("creator pop counters: creator=%d mapper=%d", *creator.counter, *mapper.counter)
	}
	mapperBuffer, err := mapper.pop()
	if err != nil {
		t.Fatal(err)
	}
	if *creator.counter != 1 || *mapper.counter != 1 {
		t.Fatalf("mapper pop counters: creator=%d mapper=%d", *creator.counter, *mapper.counter)
	}
	mapper.push(mapperBuffer)
	creator.push(creatorBuffer)
	if *creator.counter != 0 || *mapper.counter != 0 {
		t.Fatalf("returned counters: creator=%d mapper=%d", *creator.counter, *mapper.counter)
	}
}
