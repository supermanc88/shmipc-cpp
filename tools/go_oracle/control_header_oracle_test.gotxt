package shmipc

import (
	"bufio"
	"encoding/hex"
	"fmt"
	"os"
	"runtime"
	"strconv"
	"strings"
	"testing"
	"unsafe"
)

func TestControlHeaderGolden(t *testing.T) {
	events := []struct {
		name      string
		typeValue eventType
	}{
		{"ShareMemoryByFilePath", typeShareMemoryByFilePath},
		{"Polling", typePolling},
		{"StreamClose", typeStreamClose},
		{"FallbackData", typeFallbackData},
		{"ExchangeProtoVersion", typeExchangeProtoVersion},
		{"ShareMemoryByMemfd", typeShareMemoryByMemfd},
		{"AckShareMemory", typeAckShareMemory},
		{"AckReadyRecvFD", typeAckReadyRecvFD},
		{"HotRestart", typeHotRestart},
		{"HotRestartAck", typeHotRestartAck},
	}

	goldenPath := os.Getenv("SHMIPC_CONTROL_HEADER_GOLDEN")
	if goldenPath == "" {
		t.Fatal("SHMIPC_CONTROL_HEADER_GOLDEN is not set")
	}
	golden, err := os.Open(goldenPath)
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	row := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 5 {
			t.Fatalf("invalid golden row %q", line)
		}
		if row >= len(events) || fields[0] != events[row].name {
			t.Fatalf("unexpected event at row %d: %q", row, fields[0])
		}

		length, err := strconv.ParseUint(fields[1], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		version, err := strconv.ParseUint(fields[2], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		typeValue, err := strconv.ParseUint(fields[3], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		if eventType(typeValue) != events[row].typeValue {
			t.Fatalf("unexpected type for %s: %d", fields[0], typeValue)
		}

		encoded := make(header, headerSize)
		encoded.encode(uint32(length), uint8(version), events[row].typeValue)
		actual := hex.EncodeToString(encoded)
		if actual != fields[4] {
			t.Fatal(fmt.Sprintf("header mismatch for %s: expected %s, got %s", fields[0], fields[4], actual))
		}
		row++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if row != len(events) {
		t.Fatalf("expected %d event rows, got %d", len(events), row)
	}
}

func TestSharedMemoryMetadataGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_SHM_METADATA_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	eventTypes := map[string]eventType{
		"ShareMemoryByFilePath": typeShareMemoryByFilePath,
		"ShareMemoryByMemfd":    typeShareMemoryByMemfd,
	}
	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 5 {
			t.Fatalf("invalid metadata golden row %q", line)
		}
		typeValue, ok := eventTypes[fields[0]]
		if !ok {
			t.Fatalf("unknown metadata event %q", fields[0])
		}
		version, err := strconv.ParseUint(fields[1], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		queuePath, err := hex.DecodeString(fields[2])
		if err != nil {
			t.Fatal(err)
		}
		bufferPath, err := hex.DecodeString(fields[3])
		if err != nil {
			t.Fatal(err)
		}
		session := Session{
			communicationVersion: uint8(version),
			queueManager:         &queueManager{path: string(queuePath)},
			bufferManager:        &bufferManager{path: string(bufferPath)},
		}
		actual := hex.EncodeToString(session.generateShmMetadata(typeValue))
		if actual != fields[4] {
			t.Fatalf("metadata mismatch for %s: expected %s, got %s", fields[0], fields[4], actual)
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 2 {
		t.Fatalf("expected 2 metadata rows, got %d", rows)
	}
}

func TestFallbackDataGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_FALLBACK_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 5 {
			t.Fatalf("invalid fallback golden row %q", line)
		}
		version, err := strconv.ParseUint(fields[0], 10, 8)
		if err != nil {
			t.Fatal(err)
		}
		streamID, err := strconv.ParseUint(fields[1], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		status, err := strconv.ParseUint(fields[2], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		payload, err := hex.DecodeString(fields[3])
		if err != nil {
			t.Fatal(err)
		}
		var event fallbackDataEvent
		event.encode(len(event)+len(payload), uint8(version), uint32(streamID), uint32(status))
		actual := hex.EncodeToString(append(event[:], payload...))
		if actual != fields[4] {
			t.Fatalf("fallback mismatch: expected %s, got %s", fields[4], actual)
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 1 {
		t.Fatalf("expected 1 fallback row, got %d", rows)
	}
}

func TestQueueLayoutGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_QUEUE_LAYOUT_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 9 {
			t.Fatalf("invalid queue layout golden row %q", line)
		}
		if fields[0] != runtime.GOARCH {
			continue
		}
		capacity, err := strconv.ParseUint(fields[1], 10, 32)
		if err != nil {
			t.Fatal(err)
		}
		values := make([]uint64, 6)
		for index := range values {
			values[index], err = strconv.ParseUint(fields[index+2], 16, 64)
			if err != nil {
				t.Fatal(err)
			}
		}
		memory := make([]byte, countQueueMemSize(uint32(capacity)))
		queue := createQueueFromBytes(memory, uint32(capacity))
		*queue.head = int64(values[0])
		*queue.tail = int64(values[1])
		*queue.workingFlag = uint32(values[2])
		*(*uint32)(unsafe.Pointer(&queue.queueBytesOnMemory[0])) = uint32(values[3])
		*(*uint32)(unsafe.Pointer(&queue.queueBytesOnMemory[4])) = uint32(values[4])
		*(*uint32)(unsafe.Pointer(&queue.queueBytesOnMemory[8])) = uint32(values[5])
		actual := hex.EncodeToString(memory)
		if actual != fields[8] {
			t.Fatalf("queue layout mismatch for %s: expected %s, got %s", fields[0], fields[8], actual)
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 1 {
		t.Fatalf("expected one queue layout row for %s, got %d", runtime.GOARCH, rows)
	}
}

func TestBufferLayoutGolden(t *testing.T) {
	golden, err := os.Open(os.Getenv("SHMIPC_BUFFER_LAYOUT_GOLDEN"))
	if err != nil {
		t.Fatal(err)
	}
	defer golden.Close()

	bufferNum := uint32(3)
	capacityPerBuffer := uint32(4)
	memory := make([]byte, countBufferListMemSize(bufferNum, capacityPerBuffer))
	creator, err := createFreeBufferList(bufferNum, capacityPerBuffer, memory, 0)
	if err != nil {
		t.Fatal(err)
	}
	mapper, err := mappingFreeBufferList(memory, 0)
	if err != nil {
		t.Fatal(err)
	}
	base := uintptr(unsafe.Pointer(&memory[0]))
	offsets := map[string]map[string]uint64{
		"manager": {"list_count": 0, "used_length": bmCapOffset},
		"list": {
			"size": 0, "capacity": 4, "head": 8, "tail": 12,
			"capacity_per_buffer": 16,
			"creator_counter":     uint64(uintptr(unsafe.Pointer(creator.counter)) - base),
			"mapper_counter":      uint64(uintptr(unsafe.Pointer(mapper.counter)) - base),
			"region":              bufferListHeaderSize,
		},
		"slice": {
			"capacity": bufferCapOffset, "size": bufferSizeOffset,
			"data_start": bufferDataStartOffset, "next": nextBufferOffset,
			"flags": bufferFlagOffset,
		},
	}
	sizes := map[string]uint64{
		"manager": bufferManagerHeaderSize,
		"list":    bufferListHeaderSize,
		"slice":   bufferHeaderSize,
	}

	rows := 0
	scanner := bufio.NewScanner(golden)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) < 3 {
			t.Fatalf("invalid buffer layout row %q", line)
		}
		kind := fields[0]
		totalSize, err := strconv.ParseUint(fields[1], 10, 64)
		expectedSize, knownKind := sizes[kind]
		if err != nil || !knownKind || expectedSize != totalSize {
			t.Fatalf("unexpected %s layout size %s", kind, fields[1])
		}
		for _, field := range fields[2:] {
			parts := strings.Split(field, "=")
			if len(parts) != 2 {
				t.Fatalf("invalid buffer layout field %q", field)
			}
			offset, err := strconv.ParseUint(parts[1], 10, 64)
			expectedOffset, knownField := offsets[kind][parts[0]]
			if err != nil || !knownField || expectedOffset != offset {
				t.Fatalf("unexpected %s.%s offset %s", kind, parts[0], parts[1])
			}
		}
		rows++
	}
	if err := scanner.Err(); err != nil {
		t.Fatal(err)
	}
	if rows != 3 {
		t.Fatalf("expected 3 buffer layout rows, got %d", rows)
	}

	creatorBuffer, err := creator.pop()
	if err != nil {
		t.Fatal(err)
	}
	if *creator.counter != 1 || *mapper.counter != 0 {
		t.Fatalf("creator pop counters: creator=%d mapper=%d", *creator.counter, *mapper.counter)
	}
	mapperBuffer, err := mapper.pop()
	if err != nil {
		t.Fatal(err)
	}
	if *creator.counter != 1 || *mapper.counter != 1 {
		t.Fatalf("mapper pop counters: creator=%d mapper=%d", *creator.counter, *mapper.counter)
	}
	mapper.push(mapperBuffer)
	creator.push(creatorBuffer)
	if *creator.counter != 0 || *mapper.counter != 0 {
		t.Fatalf("returned counters: creator=%d mapper=%d", *creator.counter, *mapper.counter)
	}
}
